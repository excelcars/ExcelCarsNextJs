generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccessFunction {
  accessFunctionId   Int                  @id(map: "idx_16391_pk_access_function") @default(autoincrement()) @map("access_function_id")
  accessFunctionName String?              @map("access_function_name")
  roleIdLegacy       String?              @map("role_id_legacy")
  createdDate        DateTime?            @map("created_date") @db.Timestamptz(6)
  createdBy          Int?                 @map("created_by")
  updatedDate        DateTime?            @map("updated_date") @db.Timestamptz(6)
  updatedBy          Int?                 @map("updated_by")
  createdByUser      UserTable?           @relation("access_function_created_byTouser_table", fields: [createdBy], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "fk_access_function_created_by_user")
  updatedByUser      UserTable?           @relation("access_function_updated_byTouser_table", fields: [updatedBy], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "fk_access_function_updated_by_user")
  accessFunctionRole AccessFunctionRole[]

  @@map("access_function")
}

model AccessFunctionRole {
  accessFunctionId Int            @map("access_function_id")
  roleId           Int            @map("role_id")
  accessFunction   AccessFunction @relation(fields: [accessFunctionId], references: [accessFunctionId], onDelete: NoAction, onUpdate: NoAction, map: "fk_afr_function")
  roleMaster       RoleMaster     @relation(fields: [roleId], references: [roleId], onDelete: NoAction, onUpdate: NoAction, map: "fk_afr_role")

  @@id([accessFunctionId, roleId], map: "idx_16397_pk_access_function_role")
  @@map("access_function_role")
}

