NODE_ENV=development

# Firebase Storage (server only; never expose service-account credentials to the browser)
FIREBASE_STORAGE_BUCKET=excelcars-1c325.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT_PATH=
# For cloud hosting, use the one-line JSON form instead of a file path.
FIREBASE_SERVICE_ACCOUNT_JSON=

# App
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-string

# Local app / Prisma CLI database
DATABASE_URL=

# Local app / Prisma CLI Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Upstash Redis for production worker / queue
UPSTASH_REDIS_HOST=
UPSTASH_REDIS_PORT=
UPSTASH_REDIS_PASSWORD=
UPSTASH_REDIS_TLS=true

# Cloudflare R2
S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email / SMS
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Excel Cars
STAFF_CC_EMAIL=
# Public contact details shown in customer-facing vehicle links and messages.
PUBLIC_EXCEL_CARS_PHONE=+91 98203 44002
PUBLIC_EXCEL_CARS_WHATSAPP=919820344332
PUBLIC_EXCEL_CARS_CONTACT_PHONE=9820344002 / 9820344332
PUBLIC_EXCEL_CARS_EMAIL=naziya@excelcarsmumbai.com
INVENTORY_BULK_EMAIL_MAX_VEHICLES=5
INVENTORY_BULK_EMAIL_MAX_RECIPIENTS=5
INVENTORY_BULK_EMAIL_MAX_MESSAGES=25
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Meta WhatsApp Cloud API
# The URL-button origin belongs to the approved Meta template, not the API
# parameter. Configure a separately approved template per app environment:
# production: https://excelcars.vercel.app/; UAT: https://excelcaruat.vercel.app/
WHATSAPP_ENQUIRY_TEMPLATE_NAME=enquiry_temp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v23.0

# Insurance reminders are deliberately opt-in. The worker checks this daily and sends
# customer + assigned-agent notifications at 30/15/7/1 days before policy expiry.
INSURANCE_REMINDER_ENABLED=true

# Required by Vercel Cron. Use the same secret in the Vercel CRON_SECRET setting.
CRON_SECRET=Uda_w_iMnyHGGtIt_Ys4Mi1ZQ5-1Um8LxyArBghwvwA

# Third-party inquiry webhooks. Use different long random secrets for each partner.
CARDEKHO_WEBHOOK_SECRET=
JUSTDIAL_WEBHOOK_SECRET=

# Monitoring
SENTRY_DSN=
