{
  "name": "excelcars-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:staging": "node scripts/dev-staging.mjs",
    "infra:up": "docker compose up -d db redis adminer",
    "infra:down": "docker compose down",
    "infra:ps": "docker compose ps",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:ensure-inquiry-no-unique": "node scripts/ensure-inquiry-number-unique.mjs",
    "db:ensure-inquiry-status": "node scripts/ensure-inquiry-status-constraint.mjs",
    "db:ensure-inquiry-status:staging": "node scripts/ensure-inquiry-status-constraint.mjs --env-file=.env.staging.local",
    "db:ensure-inquiry-status:production": "node scripts/ensure-inquiry-status-constraint.mjs --env-file=.env.production.local --force --confirm-production",
    "db:sync-inquiry-sources": "node scripts/sync-inquiry-sources.mjs",
    "db:sync-inquiry-sources:staging": "node scripts/sync-inquiry-sources.mjs --env-file=.env.staging.local",
    "db:sync-inquiry-sources:production": "node scripts/sync-inquiry-sources.mjs --env-file=.env.production.local --force --confirm-production",
    "build": "prisma generate && next build",
    "build:only": "next build",
    "dev:only": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types src/lib/vehicleEmailLinks.test.ts src/lib/inquiryFollowupValidation.test.ts src/features/inquiry/sourceMaster.test.ts src/features/followup/vehicleFilters.test.ts",
    "test:vehicle-email-links": "node --test --experimental-strip-types src/lib/vehicleEmailLinks.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate:dev": "npx prisma migrate dev",
    "db:migrate:status": "npx prisma migrate status",
    "db:migrate:staging": "npx prisma migrate deploy",
    "db:migrate:production": "npx prisma migrate deploy",
    "db:push:staging": "node scripts/prisma-staging-push.mjs",
    "db:copy-data:staging": "node scripts/db-copy-local-data-to-staging.mjs",
    "db:push:production": "node scripts/prisma-production-push.mjs",
    "db:copy-data:production": "node scripts/db-copy-local-data-to-production.mjs",
    "docker:up": "docker compose --env-file .env.docker up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "vercel:link": "npx vercel link",
    "vercel:pull:dev": "npx vercel env pull .env.local",
    "vercel:pull:preview": "npx vercel env pull .env.preview.local --environment=preview",
    "vercel:pull:production": "npx vercel env pull .env.production.local --environment=production",
    "vercel:dev": "npx vercel env run -- npm run dev",
    "vercel:build": "npx vercel build",
    "vercel:deploy:preview": "npx vercel deploy",
    "vercel:deploy:production": "npx vercel deploy --prod",
    "worker": "node --enable-source-maps src/worker/index.mjs",
    "worker:dev": "node --watch --enable-source-maps src/worker/index.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.31.0",
    "next": "^15.5.23",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "prisma": "^6.0.0",
    "typescript": "^5.0.0"
  }
}
